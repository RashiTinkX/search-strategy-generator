# Copy to .env and fill in. run.sh loads this automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
NCBI_API_KEY=
NCBI_EMAIL=you@institution.edu

# Optional alternative providers (facets.py / openrouter_client.py route to
# these when a model id is prefixed "ollama/" or "hf/", e.g.
# "ollama/llama3.2:1b" or "hf/meta-llama/Llama-3.1-8B-Instruct")
HF_TOKEN=
OLLAMA_URL=http://localhost:11434
